{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/artist-profile",
  "title": "مشخصات هنرمند",
  "category": "music-wave",
  "description": "نمایهٔ هماهنگ و واکنش‌گرای هنرمند برای هدر انتشار، بایگانی هنرمند و ستون‌های کناری؛ با چیدمان‌های فشرده، افقی، کارتی و شاخص.",
  "keywords": [
    "بیوگرافی",
    "هنرمند",
    "پروفایل"
  ],
  "textdomain": "music-wave-core",
  "icon": "admin-users",
  "attributes": {
    "termId": {
      "type": "integer",
      "default": 0
    },
    "layout": {
      "type": "string",
      "default": "list"
    },
    "compact": {
      "type": "boolean",
      "default": false
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "showBio": {
      "type": "boolean",
      "default": true
    },
    "showLink": {
      "type": "boolean",
      "default": true
    },
    "showLibraryButton": {
      "type": "boolean",
      "default": true
    },
    "libraryButtonStyle": {
      "type": "string",
      "default": "button"
    },
    "imageSize": {
      "type": "string",
      "default": "medium"
    },
    "imageShape": {
      "type": "string",
      "default": "circle"
    },
    "ctaLabel": {
      "type": "string",
      "default": ""
    },
    "bioLength": {
      "type": "integer",
      "default": 0
    },
    "showReleaseCount": {
      "type": "boolean",
      "default": true
    },
    "accentColor": {
      "type": "string",
      "default": ""
    },
    "followIcon": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "styles": [
    {
      "name": "editorial",
      "label": "سرمقاله‌ای قاب‌دار"
    },
    {
      "name": "minimal",
      "label": "مینیمال بی‌کادر"
    },
    {
      "name": "glass",
      "label": "شیشه‌ای مات"
    }
  ],
  "example": {
    "attributes": {
      "layout": "list",
      "showImage": true,
      "showBio": true,
      "showReleaseCount": true,
      "imageShape": "circle"
    }
  }
}
