{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/dashboard-subscription",
  "title": "کارت اشتراک VIP",
  "category": "music-wave",
  "description": "نمایش وضعیت واقعی اشتراک: سطح دسترسی، اعتبار، روزهای باقی‌مانده، نوار پیشرفت و دکمه تمدید.",
  "keywords": ["اشتراک", "VIP", "عضویت", "تمدید", "اعتبار"],
  "textdomain": "music-wave-core",
  "icon": "star-filled",
  "attributes": {
    "showActive": {
      "type": "boolean",
      "default": true
    },
    "showProgress": {
      "type": "boolean",
      "default": true
    },
    "showOrderLink": {
      "type": "boolean",
      "default": false
    },
    "showRenewal": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "align": ["wide", "full"],
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "example": {
    "attributes": {
      "showActive": true,
      "showProgress": true,
      "showOrderLink": false,
      "showRenewal": true
    }
  }
}
