{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/release-card",
  "title": "کارت انتشار",
  "category": "music-wave",
  "description": "کارت انتشار MusicWave (جلد، پخش، عنوان، هنرمند، تاریخ و پیوند اقدام). داخل حلقهٔ کوئری قرار می‌گیرد و همان کارتی را می‌سازد که ویترین‌های MusicWave با PHP رندر می‌کنند.",
  "keywords": [
    "انتشار",
    "کارت",
    "حلقه",
    "کوئری",
    "ویترین"
  ],
  "textdomain": "music-wave-core",
  "icon": "format-image",
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "imageShape": {
      "type": "string",
      "default": "square"
    },
    "showArtwork": {
      "type": "boolean",
      "default": true
    },
    "showPlayButton": {
      "type": "boolean",
      "default": true
    },
    "showArtist": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": false
    },
    "showExcerpt": {
      "type": "boolean",
      "default": false
    },
    "showViews": {
      "type": "boolean",
      "default": false
    },
    "showAction": {
      "type": "boolean",
      "default": true
    },
    "actionLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "align": false,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "imageShape": "square",
      "showDate": true
    }
  }
}
