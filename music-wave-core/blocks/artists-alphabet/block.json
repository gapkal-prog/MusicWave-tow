{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/artists-alphabet",
  "title": "فیلتر الفبایی هنرمندان",
  "category": "music-wave",
  "description": "ردیف حروف الفبای فارسی برای مرور خوانندگان. حروف بدون هنرمند به‌صورت برچسب غیرقابل‌کلیک نمایش داده می‌شوند و فیلتر با جست‌وجو و ترتیب فعال ترکیب می‌شود.",
  "keywords": [
    "هنرمندان",
    "الفبا",
    "فیلتر",
    "حروف",
    "خواننده"
  ],
  "textdomain": "music-wave-core",
  "icon": "editor-textcolor",
  "attributes": {
    "showAll": {
      "type": "boolean",
      "default": true
    },
    "allLabel": {
      "type": "string",
      "default": ""
    },
    "showCounts": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "shadow": true
  },
  "example": {
    "attributes": {
      "showAll": true,
      "showCounts": false
    }
  }
}