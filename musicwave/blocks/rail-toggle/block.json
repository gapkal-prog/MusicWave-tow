{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/rail-toggle",
  "title": "دکمهٔ منوی کناری",
  "category": "music-wave",
  "description": "دکمهٔ باز/بسته کردن ریل در دسکتاپ و کشو در موبایل. یک نمونه در هر سربرگ کافی است: «نوار بالا» همیشه دیده می‌شود، «داخل برند» فقط در دسکتاپ. آیکون، برچسب و رنگ را از تنظیمات بلوک تغییر دهید.",
  "textdomain": "musicwave",
  "icon": "menu",
  "keywords": [
    "منو",
    "ریل",
    "منوی کناری",
    "آیکون منو",
    "باز کردن منو",
    "همبرگری",
    "sidebar",
    "drawer",
    "toggle"
  ],
  "attributes": {
    "variant": {
      "type": "string",
      "default": "bar",
      "enum": [
        "brand",
        "bar"
      ]
    },
    "icon": {
      "type": "string",
      "default": "menu",
      "enum": [
        "menu",
        "chevron",
        "dots",
        "arrow"
      ]
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "showLabel": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "inserter": true,
    "multiple": true,
    "reusable": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "html": false,
    "interactivity": false
  },
  "example": {
    "attributes": {
      "variant": "bar",
      "icon": "menu"
    }
  }
}
