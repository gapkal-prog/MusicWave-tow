{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/release-shelf",
  "title": "ویترین انتشارهای MusicWave",
  "category": "music-wave",
  "description": "نمایش انتشارها بهصورت شبکهای، ویترین افقی، فهرست جمعوجور، ویژهنامه سرمقاله یا اسلایدر هیرو. بین انتشارها و فهرستهای پخش عمومی جامعه جابهجا شوید. چیدمان، رنگها و فاصلهها در ویرایشگر سایت قابل ویرایش هستند.",
  "keywords": [
    "ویترین",
    "شبکه",
    "انتشارها",
    "فهرست پخش",
    "کاتالوگ",
    "موسیقی",
    "اسلایدر",
    "هیرو"
  ],
  "textdomain": "musicwave",
  "icon": "screenoptions",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "DESC"
    },
    "taxonomy": {
      "type": "string",
      "default": ""
    },
    "termSlug": {
      "type": "string",
      "default": ""
    },
    "releaseIds": {
      "type": "string",
      "default": ""
    },
    "itemsToShow": {
      "type": "integer",
      "default": 8
    },
    "columns": {
      "type": "integer",
      "default": 4
    },
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "styleVariant": {
      "type": "string",
      "default": ""
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "interval": {
      "type": "integer",
      "default": 5000
    },
    "imageShape": {
      "type": "string",
      "default": "square"
    },
    "showArtwork": {
      "type": "boolean",
      "default": true
    },
    "showPlayButton": {
      "type": "boolean",
      "default": true
    },
    "showArtist": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": false
    },
    "showDate": {
      "type": "boolean",
      "default": false
    },
    "showAction": {
      "type": "boolean",
      "default": true
    },
    "actionLabel": {
      "type": "string",
      "default": ""
    },
    "sectionUrl": {
      "type": "string",
      "default": ""
    },
    "sectionLinkLabel": {
      "type": "string",
      "default": ""
    },
    "featuredReleaseId": {
      "type": "integer",
      "default": 0
    },
    "featuredSource": {
      "type": "string",
      "default": "excerpt"
    },
    "overlay": {
      "type": "integer",
      "default": 50
    },
    "showRank": {
      "type": "boolean",
      "default": false
    },
    "showViews": {
      "type": "boolean",
      "default": false
    },
		"contentType": {
			"type": "string",
			"default": ""
		},
		"datePeriod": {
			"type": "string",
			"enum": [ "", "all", "today", "day", "week", "7d", "month", "30d", "year" ],
			"default": ""
		},
    "source": {
      "type": "string",
      "default": "releases"
    },
    "playlistSearch": {
      "type": "string",
      "default": ""
    },
    "playlistOrderBy": {
      "type": "string",
      "default": "updated_at"
    },
    "ctaLabel": {
      "type": "string",
      "default": ""
    },
    "ctaStyle": {
      "type": "string",
      "default": "solid"
    },
    "ctaBgColor": {
      "type": "string",
      "default": ""
    },
    "ctaTextColor": {
      "type": "string",
      "default": ""
    },
    "ctaRadius": {
      "type": "integer",
      "default": 999
    },
    "heroTitleColor": {
      "type": "string",
      "default": ""
    },
    "heroTitleSize": {
      "type": "integer",
      "default": 0
    },
    "heroTextColor": {
      "type": "string",
      "default": ""
    },
    "asideTitle": {
      "type": "string",
      "default": ""
    },
    "sideColumnWidth": {
      "type": "integer",
      "default": 340
    },
    "filterTabs": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "color": {
      "background": true,
      "text": true,
      "gradient": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true,
      "aspectRatio": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "shadow": true,
    "interactivity": false
  },
  "example": {
    "attributes": {
      "eyebrow": "موسیقی جدید",
      "title": "آخرین انتشارها",
      "itemsToShow": 8,
      "columns": 4,
      "layout": "grid"
    }
  }
}
