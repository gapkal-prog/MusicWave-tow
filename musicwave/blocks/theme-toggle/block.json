{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/theme-toggle",
  "title": "تغییر پوسته",
  "category": "music-wave",
  "description": "دکمهٔ تغییر پوسته (روشن/تیره/سیستم). قابل حذف/جابه‌جایی در ویرایشگر سایت. کلاس nbp-theme-toggle-fallback همیشه در نوار بالا موجود است.",
  "textdomain": "musicwave",
  "icon": "art",
  "keywords": ["پوسته", "تاریک", "روشن", "theme", "dark", "light"],
  "attributes": {
    "showLabel": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "inserter": true,
    "multiple": true,
    "reusable": true,
    "interactivity": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "html": false
  },
  "example": {
    "attributes": {}
  }
}
