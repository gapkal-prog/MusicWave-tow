      "radius": {
        "small": "0.5rem",
        "medium": "0.75rem",
        "large": "1rem",
        "xlarge": "1.5rem",
        "pill": "999px"
      },
      "header": {
        "contentSize": "var(--wp--style--global--wide-size, 100%)"
      }
