  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|text"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|30",
      "padding": {
        "left": "var:preset|spacing|30",
        "right": "var:preset|spacing|30"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|on-accent" },
        "spacing": { "padding": { "top": "0.75rem", "right": "1.5rem", "bottom": "0.75rem", "left": "1.5rem" } },
        "typography": { "fontWeight": "700" },
        ":hover": {
          "color": { "background": "var:preset|color|accent-strong", "text": "var:preset|color|on-accent" }
        }
      },
      "heading": { "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "800", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "link": { "color": { "text": "var:preset|color|accent-strong" }, "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } },
      "caption": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "var:preset|font-size|small" } },
      "cite": { "typography": { "fontSize": "var:preset|font-size|small", "fontStyle": "normal" }, "color": { "text": "var:preset|color|muted" } }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontWeight": "600" } },
      "core/search": { "border": { "radius": "999px" } },
      "core/post-featured-image": { "border": { "radius": "1rem" } },
      "core/post-template": { "spacing": { "blockGap": "var:preset|spacing|30" } },
      "core/paragraph": { "spacing": { "blockGap": "var:preset|spacing|20" } },
      "core/separator": { "color": { "background": "var:preset|color|muted" } },
      "core/quote": { "border": { "width": "3px", "color": "var:preset|color|accent" }, "spacing": { "padding": { "left": "var:preset|spacing|30" } } },
      "core/group": {
        "spacing": { "blockGap": "var:preset|spacing|30" }
      },
      "core/list": {
        "spacing": { "blockGap": "var:preset|spacing|10" }
      },
      "music-wave/release-shelf": {
        "spacing": { "blockGap": "var:preset|spacing|30" }
      },
      "music-wave/release-slider": {
        "spacing": { "blockGap": "var:preset|spacing|30" }
      },
      "musicwave/release-shelf": {
        "spacing": { "blockGap": "var:preset|spacing|30" }
      },
      "musicwave/release-slider": {
        "spacing": { "blockGap": "var:preset|spacing|30" }
      },
      "music-wave/header-search": {
        "spacing": { "blockGap": "var:preset|spacing|20" }
      },
      "musicwave/header-search": {
        "spacing": { "blockGap": "var:preset|spacing|20" }
      }
    }
  },
