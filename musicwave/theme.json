        { "slug": "x-small", "size": "0.75rem", "name": "خیلی کوچک" },
        { "slug": "small", "size": "0.875rem", "name": "کوچک" },
        { "slug": "medium", "size": "1rem", "name": "متوسط" },
        { "slug": "large", "size": "clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem)", "name": "بزرگ" },
        { "slug": "x-large", "size": "clamp(2rem, 1.4rem + 2.8vw, 4.5rem)", "name": "نمایشی" },
        { "slug": "xx-large", "size": "clamp(2.75rem, 1.8rem + 4vw, 5.5rem)", "name": "تیتر اصلی" }
      ]
    },
    "custom": {
      "scheme": {
        "light": { "canvas": "#f7f7f8", "surface": "#ffffff", "surfaceRaised": "#eef0f2", "text": "#0f1115", "muted": "#5b6170", "accent": "#15803d", "accentStrong": "#166534", "editorial": "#be123c", "onAccent": "#ffffff" },
        "dark": { "canvas": "#0a0a0a", "surface": "#181818", "surfaceRaised": "#282828", "text": "#f7f8fb", "muted": "#a0a0a0", "accent": "#1db954", "accentStrong": "#1ed760", "editorial": "#fa2d48", "onAccent": "#052e16" }
