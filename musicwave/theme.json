{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%",
      "allowEditing": true,
      "allowCustomContentAndWideSize": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "fixed": true,
      "sticky": true
    },
    "shadow": {
      "presets": [
        {
          "slug": "card",
          "name": "کارت",
          "shadow": "0 18px 50px rgb(0 0 0 / 24%)"
        },
        {
          "slug": "floating",
          "name": "پخش‌کننده شناور",
          "shadow": "0 24px 70px rgb(0 0 0 / 40%)"
        },
        {
          "slug": "subtle",
          "name": "ظریف",
          "shadow": "0 8px 24px rgb(0 0 0 / 12%)"
        },
        {
          "slug": "elevated",
          "name": "برجسته",
          "shadow": "0 24px 48px rgb(0 0 0 / 18%)"
        }
      ]
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": true,
      "defaultPalette": false,
      "custom": true,
      "customGradient": true,
      "customDuotone": false,
      "link": true,
      "gradients": [
        {
          "slug": "accent-wash",
          "name": "گرادیان تأکیدی",
          "gradient": "radial-gradient(circle at 15% 20%, rgba(29,185,84,0.35), transparent 55%), linear-gradient(180deg, #283040, #0b0d12)"
        },
        {
          "slug": "accent-button",
          "name": "دکمه تأکیدی",
          "gradient": "linear-gradient(135deg, #1ed760, #17a34a)"
        },
        {
          "slug": "editorial-rose",
          "name": "رز تحریریه",
          "gradient": "linear-gradient(135deg, #fa2d48, #a91267 55%, #341550)"
        },
        {
          "slug": "midnight-radio",
          "name": "رادیوی نیمه‌شب",
          "gradient": "radial-gradient(circle at 75% 15%, rgba(124,58,237,0.55), transparent 42%), linear-gradient(145deg, #1f2937, #08090d)"
        },
        {
          "slug": "sunset-glow",
          "name": "درخشش غروب",
          "gradient": "linear-gradient(135deg, #ff7a18 0%, #fa2d48 55%, #9a1b8f 100%)"
        },
        {
          "slug": "midnight-ink",
          "name": "جوهر نیمه‌شب",
          "gradient": "linear-gradient(180deg, #111827, #0b0d12)"
        }
      ],
      "palette": [
        { "slug": "canvas", "name": "بوم", "color": "#0a0a0a" },
        { "slug": "surface", "name": "سطح", "color": "#181818" },
        { "slug": "surface-raised", "name": "سطح برجسته", "color": "#282828" },
        { "slug": "text", "name": "متن", "color": "#f7f8fb" },
        { "slug": "muted", "name": "متن کم‌رنگ", "color": "#a0a0a0" },
        { "slug": "accent", "name": "رنگ تأکیدی", "color": "#1db954" },
        { "slug": "accent-strong", "name": "رنگ تأکیدی پررنگ", "color": "#1ed760" },
        { "slug": "editorial", "name": "رز تحریریه", "color": "#fa2d48" },
        { "slug": "on-accent", "name": "روی رنگ تأکیدی", "color": "#052e16" }
      ],
      "duotone": [
        {
          "slug": "accent-on-canvas",
          "colors": ["#0b0d12", "#1db954"],
          "name": "تأکید روی بوم"
        },
        {
          "slug": "editorial-on-canvas",
          "colors": ["#090a0f", "#fa2d48"],
          "name": "تحریریه روی بوم"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "10", "size": "clamp(0.5rem, 0.45rem + 0.2vw, 0.75rem)", "name": "خیلی کوچک" },
        { "slug": "20", "size": "clamp(0.75rem, 0.7rem + 0.25vw, 1rem)", "name": "کوچک" },
        { "slug": "30", "size": "clamp(1rem, 0.85rem + 0.7vw, 1.5rem)", "name": "متوسط" },
        { "slug": "40", "size": "clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)", "name": "بزرگ" },
        { "slug": "50", "size": "clamp(2.5rem, 1.8rem + 3vw, 5rem)", "name": "خیلی بزرگ" },
        { "slug": "60", "size": "clamp(3.5rem, 2.8rem + 3vw, 6.5rem)", "name": "بسیار بزرگ" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "defaultFontSizes": false,
      "customFontSize": true,
      "lineHeight": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textTransform": true,
      "textDecoration": true,
      "writingMode": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "بدنه وزیرمتن",
          "fontFamily": "'Vazirmatn', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif"
        },
        {
          "slug": "serif",
          "name": "سریف تحریریه",
          "fontFamily": "Iowan Old Style, Baskerville, 'Times New Roman', serif"
        },
        {
          "slug": "mono",
          "name": "تک‌فاصله استودیو",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        },
        {
          "slug": "display",
          "name": "نمایشی وزیرمتن",
          "fontFamily": "'Vazirmatn', 'Syne', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        }
